<Window x:Class="WinDynamicNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDynamicNotch"
        Width="396"
        Height="70"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <Style x:Key="GlyphText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="28" Background="#F2FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekThumb" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse Width="12" Height="12" Fill="#FFFFFFFF" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#F2FFFFFF" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#2BFFFFFF" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SeekFill}" Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SeekThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SeekEmpty}" Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">

        <!-- Мягкая тень под карточкой (форма анимируется вместе с карточкой) -->
        <Border x:Name="CardShadow" Margin="10" CornerRadius="24" Background="#7A000000">
            <Border.Effect>
                <BlurEffect Radius="18" />
            </Border.Effect>
        </Border>

        <Border x:Name="Card"
                Margin="12"
                CornerRadius="22"
                Background="#F0141417"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid x:Name="CardContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== Компактная строка ===== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="HeaderClickArea"
                          Grid.Column="0"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonUp="HeaderClickArea_MouseLeftButtonUp">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="30"
                                Height="30"
                                Margin="10,0,10,0"
                                CornerRadius="9"
                                Background="#1AFFFFFF"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="CompactArtPlaceholder"
                                           Text="&#xE8D6;"
                                           Style="{StaticResource GlyphText}"
                                           FontSize="13"
                                           Foreground="#59FFFFFF" />
                                <Image x:Name="CompactArt" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,30,30" RadiusX="9" RadiusY="9" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="CompactTitle"
                                       Text="Ничего не воспроизводится"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CompactArtist"
                                       Text="Запустите музыку или видео"
                                       Margin="0,1,0,0"
                                       FontSize="11"
                                       Foreground="#8CFFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button x:Name="CompactPrevButton"
                                Style="{StaticResource IconButton}"
                                Width="30"
                                Height="30"
                                VerticalAlignment="Center"
                                ToolTip="Предыдущий трек"
                                Click="Previous_Click">
                            <TextBlock Text="&#xE892;"
                                       Style="{StaticResource GlyphText}"
                                       FontSize="12"
                                       Foreground="#D9FFFFFF" />
                        </Button>

                        <Button x:Name="CompactPlayButton"
                                Style="{StaticResource IconButton}"
                                Width="34"
                                Height="34"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                ToolTip="Воспроизведение / пауза"
                                Click="PlayPause_Click">
                            <TextBlock x:Name="CompactPlayGlyph"
                                       Text="&#xE768;"
                                       Style="{StaticResource GlyphText}"
                                       FontSize="14"
                                       Foreground="#F2FFFFFF" />
                        </Button>

                        <Button x:Name="CompactNextButton"
                                Style="{StaticResource IconButton}"
                                Width="30"
                                Height="30"
                                VerticalAlignment="Center"
                                ToolTip="Следующий трек"
                                Click="Next_Click">
                            <TextBlock Text="&#xE893;"
                                       Style="{StaticResource GlyphText}"
                                       FontSize="12"
                                       Foreground="#D9FFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== Раскрытая карточка ===== -->
                <Grid x:Name="ExpandedPanel"
                      Grid.Row="1"
                      Margin="20,2,20,14"
                      Opacity="0"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="ExpandedArtHost"
                          Grid.Row="0"
                          Width="300"
                          Height="300"
                          HorizontalAlignment="Center">
                        <Border CornerRadius="16" Background="#12FFFFFF">
                            <Grid>
                                <TextBlock x:Name="BigArtPlaceholder"
                                           Text="&#xE8D6;"
                                           Style="{StaticResource GlyphText}"
                                           FontSize="72"
                                           Foreground="#2EFFFFFF" />
                                <Image x:Name="BigArt" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,300,300" RadiusX="16" RadiusY="16" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource IconButton}"
                                Width="28"
                                Height="28"
                                Margin="0,8,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                ToolTip="Свернуть"
                                Click="Collapse_Click">
                            <TextBlock Text="&#xE70E;"
                                       Style="{StaticResource GlyphText}"
                                       FontSize="12"
                                       Foreground="#B3FFFFFF" />
                        </Button>
                    </Grid>

                    <StackPanel x:Name="ExpandedTextBlock" Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock x:Name="ExpandedTitle"
                                   Text="Ничего не воспроизводится"
                                   HorizontalAlignment="Center"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#F5FFFFFF"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ExpandedArtist"
                                   Text="Нет активной медиасессии"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="#8CFFFFFF"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid x:Name="ExpandedSeekBlock" Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Slider x:Name="SeekSlider"
                                Grid.Row="0"
                                Style="{StaticResource SeekSlider}"
                                ValueChanged="SeekSlider_ValueChanged" />

                        <Grid Grid.Row="1" Margin="2,2,2,0">
                            <TextBlock x:Name="PositionText"
                                       Text="0:00"
                                       FontSize="10.5"
                                       Foreground="#7AFFFFFF" />
                            <TextBlock x:Name="DurationText"
                                       Text="0:00"
                                       HorizontalAlignment="Right"
                                       FontSize="10.5"
                                       Foreground="#7AFFFFFF" />
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="ExpandedControls"
                                Grid.Row="3"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                ToolTip="Предыдущий трек"
                                Click="Previous_Click">
                            <TextBlock Text="&#xE892;"
                                       Style="{StaticResource GlyphText}"
                                       FontSize="16"
                                       Foreground="#E6FFFFFF" />
                        </Button>

                        <Button x:Name="PlayButton"
                                Style="{StaticResource PrimaryButton}"
                                Margin="22,0"
                                VerticalAlignment="Center"
                                ToolTip="Воспроизведение / пауза"
                                Click="PlayPause_Click">
                            <TextBlock x:Name="PlayPauseGlyph"
                                       Text="&#xE768;"
                                       Style="{StaticResource GlyphText}"
                                       FontSize="20"
                                       Foreground="#0B0B0E" />
                        </Button>

                        <Button Style="{StaticResource IconButton}"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                ToolTip="Следующий трек"
                                Click="Next_Click">
                            <TextBlock Text="&#xE893;"
                                       Style="{StaticResource GlyphText}"
                                       FontSize="16"
                                       Foreground="#E6FFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
